# Copy to .env and fill in. Never commit .env.

# Which provider the UI selects first: gemini | ollama
DEFAULT_PROVIDER=gemini

# Gemini (cloud). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-lite-latest is fast (~4–5 s); gemini-flash-latest is stronger but was often overloaded (503)
GEMINI_MODEL=gemini-flash-lite-latest
# Tried on the retry when the main model fails or is overloaded. "none" turns it off.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Ollama (local). Install https://ollama.com, then: ollama pull gemma4:e2b
OLLAMA_SERVER=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
# Context window in tokens (Ollama's default is 4096)
OLLAMA_NUM_CTX=8192

# Port for the production server (node dist/site-summariser/server/server.mjs)
PORT=4000

